rules_version = '2';
// LinkUp Firestore security rules (Step 6 — Login SignUp plan).
// User document shape: users/<uid> with map "AuthenticationData" (id, username, email).
// Usernames: usernames/<lowercase-username> with { uid: string, profileImageURL?: string } for sign-up and Add Friends search.
// Friends: users/<uid>/friends/<friendUid> — owner can read/write; friendUid can write (so accepter can add themselves to sender's list).
// Friend requests: friend_requests/<requestId> — fromUid/toUid can read; toUid can update (accept/reject).
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the signed-in user can read/write their own document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Friends: owner can read/write; the "friend" (friendUid) can write so that when A accepts B's request, A can write to users/B/friends/A.
      match /friends/{friendUid} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.uid == friendUid);
      }
    }
    // Anyone can read (to check "is this username taken?" before sign-up). Only signed-in user can create/update/delete their claim.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // Friend requests: create as fromUid; read if you're fromUid or toUid; only toUid can update (accept/reject).
    match /friend_requests/{requestId} {
      allow read: if request.auth != null && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.toUid == request.auth.uid;
      allow delete: if false;
    }
    // Polls: visible only to uids in visibleToUids; any signed-in user can create; only viewers (in visibleToUids) can update (vote); only creator can delete.
    match /polls/{pollId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.visibleToUids;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid in resource.data.visibleToUids;
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
      // Responses: who voted for which option. Any signed-in user can read; users write only their own.
      match /responses/{userId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == userId;
        allow delete: if false;
      }
    }
    // Conversations (DMs and groups): only participants can read/write.
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participantIds;
      match /messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
      }
    }
  }
}
